From 2aee55c4bc4877322a9668628daecf3da1090e0e Mon Sep 17 00:00:00 2001
From: Huntez <osigor5464@gmail.com>
Date: Sat, 7 Nov 2026 08:50:20 +0100
Subject: [PATCH] Forward jumps as if/else blocks instead of the pc loop where
 they nest

---
 XenosRecomp/pch.h                 |  2 +
 XenosRecomp/shader_recompiler.cpp | 69 +++++++++++++++++++++++++++++--
 2 files changed, 67 insertions(+), 4 deletions(-)

diff --git a/XenosRecomp/pch.h b/XenosRecomp/pch.h
index e59682c..48ccae2 100644
--- a/XenosRecomp/pch.h
+++ b/XenosRecomp/pch.h
@@ -16,6 +16,8 @@
 #include <fmt/core.h>
 #include <string>
 #include <unordered_map>
+#include <unordered_set>
+#include <vector>
 #include <xxhash.h>
 #include <zstd.h>
 
diff --git a/XenosRecomp/shader_recompiler.cpp b/XenosRecomp/shader_recompiler.cpp
index 9cc770e..15ee3b3 100644
--- a/XenosRecomp/shader_recompiler.cpp
+++ b/XenosRecomp/shader_recompiler.cpp
@@ -1798,6 +1798,16 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
     uint32_t instrAddress = 0;
     uint32_t instrSize = shader->size;
     bool simpleControlFlow = true;
+    // Forward jumps nest as if blocks. An unconditional jump that ends an if
+    // block (the last instruction before the block's end) and lands past it,
+    // within the enclosing block, is that block's else. Anything else (a jump
+    // back, blocks that overlap) falls back to the pc loop, which some
+    // drivers compile far worse: AMD's Windows driver spills every register of
+    // those vertex shaders to scratch (#2).
+    std::vector<uint32_t> openIfEnds;  // innermost last
+    std::unordered_set<uint32_t> elseJumps;  // the unconditional jumps that are an else
+    std::unordered_set<uint32_t> nextJumps;  // unconditional jumps to the next instruction (an empty else)
+    uint32_t cfIndex = 0;
 
     while (instrAddress < instrSize)
     {
@@ -1810,6 +1820,9 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
         {
             uint32_t address = 0;
 
+            while (!openIfEnds.empty() && openIfEnds.back() <= cfIndex)
+                openIfEnds.pop_back();
+
             switch (cfInstr.opcode)
             {
             case ControlFlowOpcode::Exec:
@@ -1831,10 +1844,39 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
 
             case ControlFlowOpcode::CondJmp:
             {
-                if (cfInstr.condJmp.isUnconditional || cfInstr.condJmp.direction)
+                uint32_t target = cfInstr.condJmp.address;
+                size_t open = openIfEnds.size();
+                uint32_t outerEnd = open >= 2 ? openIfEnds[open - 2] : UINT32_MAX;
+                if (cfInstr.condJmp.direction)
+                {
                     simpleControlFlow = false;
+                }
+                else if (cfInstr.condJmp.isUnconditional && target == cfIndex + 1)
+                {
+                    nextJumps.insert(cfIndex);
+                }
+                else if (cfInstr.condJmp.isUnconditional)
+                {
+                    if (open != 0 && openIfEnds.back() == cfIndex + 1 && outerEnd > cfIndex + 1 &&
+                        target > cfIndex + 1 && target <= outerEnd)
+                    {
+                        --ifEndLabels[cfIndex + 1];
+                        ++ifEndLabels[target];
+                        openIfEnds.back() = target;
+                        elseJumps.insert(cfIndex);
+                    }
+                    else
+                    {
+                        simpleControlFlow = false;
+                    }
+                }
                 else
-                    ++ifEndLabels[cfInstr.condJmp.address];
+                {
+                    if (target <= cfIndex || (open != 0 && target > openIfEnds.back()))
+                        simpleControlFlow = false;
+                    ++ifEndLabels[target];
+                    openIfEnds.push_back(target);
+                }
 
                 break;
             }
@@ -1842,6 +1884,8 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
 
             if (address != 0)
                 instrSize = std::min<uint32_t>(instrSize, address * 12);
+
+            ++cfIndex;
         }
 
         controlFlowCode += 3;
@@ -1968,9 +2012,26 @@ void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_vi
 
             case ControlFlowOpcode::CondJmp:
             {
-                if (cfInstr.condJmp.isUnconditional)
+                if (cfInstr.condJmp.isUnconditional && simpleControlFlow && nextJumps.count(pc - 1) != 0)
+                {
+                    // Lands on the next instruction: nothing to do.
+                }
+                else if (cfInstr.condJmp.isUnconditional && simpleControlFlow)
+                {
+                    // The end of an if block (closed here instead of at its
+                    // end label): the instructions up to the target are its else.
+                    assert(elseJumps.count(pc - 1) != 0);
+                    --indentation;
+                    indent();
+                    out += "}\n";
+                    indent();
+                    out += "else\n";
+                    indent();
+                    out += "{\n";
+                    ++indentation;
+                }
+                else if (cfInstr.condJmp.isUnconditional)
                 {
-                    assert(!simpleControlFlow);
                     println("\t\t\tpc = {};", uint32_t(cfInstr.condJmp.address));
                     out += "\t\t\tcontinue;\n";
                 }
-- 
